#!/usr/bin/env python3
"""Keep the overview of every reviewed, open pull request in the ink-drop library.

A new or changed overview becomes an EPUB, ready for the tablet. Once its pull
request closes, the book leaves both folders, and so the tablet at the next
sync. A pull request on a private repository is never sent, nor is any book this
script did not make touched.

Reads ~/.config/ink-drop/reviews.json, where target names the repository of a
source's reviews, for one that does not link its pull request:

    {"sources": [{"repo": "owner/reviews"}, {"repo": "o/r", "target": "o/app"}]}

Run it by hand or from the sync switch. Any failure to read GitHub stops the run
before it removes anything.
"""
import json
import os
import re
import shutil
import struct
import subprocess
import sys
import tempfile
import time
import urllib.parse
from pathlib import Path

CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "ink-drop"
STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "ink-reviews.json"
OVERVIEW = re.compile(r"(^|/)reviews/(.*/)?overview\.md$")
PR_URL = re.compile(r"github\.com/([\w.-]+/[\w.-]+)/pull/(\d+)")
PR_LINE = re.compile(r"^PR:\s*\[([\w.-]+/[\w.-]+)#(\d+)\]", re.M)
PR_SLUG = re.compile(r"/(\d+)-[^/]*/overview\.md$")
MAX_PRS = 5000


def gh(*args):
    return subprocess.run(["gh", *args], check=True, capture_output=True, text=True).stdout


def contents(repo, path, accept):
    url = f"repos/{repo}/contents/{urllib.parse.quote(path)}"
    return gh("api", url, "-H", f"Accept: application/vnd.github.{accept}")


def overviews(repo):
    tree = json.loads(gh("api", f"repos/{repo}/git/trees/HEAD?recursive=1"))
    if tree["truncated"]:
        raise RuntimeError(f"{repo}: GitHub cut the file list short")
    return [(e["path"], e["sha"]) for e in tree["tree"] if e["type"] == "blob" and OVERVIEW.search(e["path"])]


def find_pr(text, path, target):
    """Returns the pull request an overview is about, as owner/repo#n, or None."""
    head = "\n".join(text.splitlines()[:15])
    m = PR_LINE.search(head) or PR_URL.search(head)
    if m:
        return f"{m[1]}#{m[2]}"
    m = PR_SLUG.search(path)
    return f"{target}#{m[1]}" if target and m else None


def heading(text):
    """Returns the first heading in plain words, its links reduced to their text."""
    for line in text.splitlines():
        if line.startswith("# "):
            return re.sub(r"\[([^\]]*)\]\([^)]*\)", r"\1", line[2:]).strip()
    return "overview"


def open_prs(repo):
    """Returns the open pull request numbers of a public repository, none of a private one."""
    if json.loads(gh("api", f"repos/{repo}"))["private"]:
        return set()
    rows = json.loads(gh("pr", "list", "-R", repo, "--state", "open", "--limit", str(MAX_PRS), "--json", "number"))
    if len(rows) == MAX_PRS:
        raise RuntimeError(f"{repo}: over {MAX_PRS} open pull requests")
    return {r["number"] for r in rows}


def host(action, name):
    """Asks ink-send for one action, the same way the extension does."""
    body = json.dumps({"action": action, "file": name}).encode()
    out = subprocess.run(["ink-send"], input=struct.pack("=I", len(body)) + body, check=True, capture_output=True).stdout
    res = json.loads(out[4:])
    if not res.get("ok"):
        raise RuntimeError(f"ink-send {action} {name}: {res.get('error')}")


def free_name(library, name):
    stem, ext = os.path.splitext(name)
    i, try_name = 1, name
    while (library / try_name).exists():
        try_name, i = f"{stem}-{i}{ext}", i + 1
    return try_name


def build(library, pr, repo, path, text):
    """Writes the overview as an EPUB in the library, and returns its file name."""
    html = contents(repo, path, "html")
    title = f"{pr.split('/')[1]} {heading(text)}"
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        (tmp / "in/.ink").mkdir(parents=True)
        (tmp / "in/overview.html").write_text(f"<!doctype html><html><body>{html}</body></html>")
        (tmp / "in/.ink/overview.html.json").write_text(json.dumps({
            "schema": 1, "file": "overview.html", "title": title,
            "source": f"https://github.com/{repo}/blob/HEAD/{urllib.parse.quote(path)}",
            "fetched": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "stage": "ink-reviews",
        }))
        made = subprocess.run(["ink-epub", "-to", str(tmp / "out")], input=f"{tmp}/in/overview.html\n",
                              check=True, capture_output=True, text=True).stdout.strip()
        name = free_name(library, os.path.basename(made))
        side = library / ".ink"
        side.mkdir(exist_ok=True)
        meta = json.loads((tmp / "out/.ink" / f"{os.path.basename(made)}.json").read_text())
        meta["file"] = name
        (side / f"{name}.json").write_text(json.dumps(meta, indent=2) + "\n")
        shutil.move(made, library / name)
    return name


def main():
    sources = json.loads((CONFIG / "reviews.json").read_text())["sources"]
    folders = json.loads((CONFIG / "folders.json").read_text())
    library = Path(folders["library"]).expanduser()
    state = json.loads(STATE.read_text()) if STATE.exists() else {"overviews": {}, "books": {}}
    seen, wanted = state["overviews"], {}

    # Read every overview once, then only when its contents change.
    for source in sources:
        repo = source["repo"]
        for path, sha in overviews(repo):
            key = f"{repo}:{path}"
            if seen.get(key, {}).get("sha") != sha:
                text = contents(repo, path, "raw")
                seen[key] = {"sha": sha, "pr": find_pr(text, path, source.get("target"))}
            pr = seen[key]["pr"]
            if pr:
                wanted.setdefault(pr, (repo, path, sha))

    still_open = {r: open_prs(r) for r in {pr.split("#")[0] for pr in wanted}}
    keep = {pr: w for pr, w in wanted.items() if int(pr.split("#")[1]) in still_open[pr.split("#")[0]]}
    # A book's repository may have no overview left, so it is asked about too.
    for pr in state["books"]:
        repo = pr.split("#")[0]
        if repo not in still_open:
            still_open[repo] = open_prs(repo)

    added, updated, removed, failed = 0, 0, 0, 0
    for pr, (repo, path, sha) in sorted(keep.items()):
        book = state["books"].get(pr)
        if book and book["sha"] == sha and (library / book["name"]).exists():
            continue
        try:
            text = contents(repo, path, "raw")
            if book and (library / book["name"]).exists():
                host("delete", book["name"])
            name = build(library, pr, repo, path, text)
            host("send", name)
            state["books"][pr] = {"name": name, "sha": sha}
            added, updated = (added, updated + 1) if book else (added + 1, updated)
        except (subprocess.CalledProcessError, RuntimeError, OSError) as err:
            failed += 1
            print(f"ink-reviews: {pr}: {err}", file=sys.stderr)

    for pr, book in list(state["books"].items()):
        repo, number = pr.split("#")
        if pr in keep or int(number) in still_open[repo]:
            continue
        if (library / book["name"]).exists():
            host("delete", book["name"])
        del state["books"][pr]
        removed += 1

    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps(state, indent=1))
    print(f"ink-reviews: {len(state['books'])} on open pull requests, "
          f"{added} added, {updated} updated, {removed} removed, {failed} failed")
    return 1 if failed else 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (subprocess.CalledProcessError, RuntimeError, OSError, KeyError, ValueError) as err:
        print(f"ink-reviews: stopped, nothing removed: {err}", file=sys.stderr)
        sys.exit(1)
