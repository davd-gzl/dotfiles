{
    "editor.fontFamily": "'Fira Code', 'JetBrains Mono', monospace",
    "editor.fontLigatures": true,
    "editor.fontWeight": "545",
    "editor.fontSize": 16,
    "terminal.integrated.fontWeight": "540",
    "terminal.integrated.fontWeightBold": "600",
    "editor.lineHeight": 1.20,
    "editor.letterSpacing": -0.2,
    "terminal.integrated.fontSize": 15,
    "chat.editor.fontSize": 20,
    "markdown.preview.fontSize": 15,
    "chat.editor.fontFamily": "'Fira Code', monospace",
    "markdown.preview.fontFamily": "'Fira Code', monospace",
    "files.autoSave": "onFocusChange",
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false,
        "gno": false
    },
    "git.autofetch": true,
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    },
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "workbench.editor.empty.hint": "hidden",
    "github.copilot.nextEditSuggestions.enabled": true,
    "workbench.settings.openDefaultKeybindings": true,
    "python.defaultInterpreterPath": "/sbin/python3.14",
    "git.suggestSmartCommit": false,
    "git.blame.editorDecoration.enabled": true,
    "chat.tools.terminal.autoApprove": {
        "go": true,
        "gnoweb_airgapped": true,
        "adduserfrom)$\"": true,
        "gno": true,
        "./build/supernova": true,
        "sed": true,
        "npm run all": true
    },
    "chat.agent.maxRequests": 100,
    "go.toolsManagement.autoUpdate": true,
    "githubPullRequests.pullBranch": "never",
    "security.workspace.trust.untrustedFiles": "open",
    "claudeCode.preferredLocation": "panel",
    "diffEditor.ignoreTrimWhitespace": false,
    "workbench.colorTheme": "Solarized Dark+",
    "window.autoDetectColorScheme": true,
    "workbench.preferredDarkColorTheme": "Solarized Dark+",
    "workbench.preferredLightColorTheme": "Solarized Light+",
    "terminal.integrated.fontFamily": "'Fira Code', 'JetBrains Mono', monospace",
    "diffEditor.renderSideBySide": false,
    "markdown-preview-enhanced.previewTheme": "vscode.css",
    "go.languageServerFlags": ["-remote=auto"],
    "gopls": {
        "ui.diagnostic.staticcheck": false,
        "ui.diagnostic.analyses": {
            "unusedparams": false,
            "unusedwrite": false
        }
    },
    "go.lintOnSave": "off",
    "go.vetOnSave": "off",
    "security.promptForLocalFileProtocolHandling": false,
    // Do not pin GNOROOT here: gnopls would then resolve stdlibs from that one
    // checkout no matter which gno tree is open, so every other worktree gets
    // stale stdlibs and "missed import" errors. Left unset, gnoenv infers it
    // per folder via `go list -m github.com/gnolang/gno`.
    "gno.toolsEnvVars": {
        "GOPACKAGESDRIVER": ":memory:"
    },
    "gno.lintOnSave": "off",
    "gno.vetOnSave": "off",
    "gnopls": {
        // Filters are relative to the open folder, so an allowlist tied to one
        // layout ("-", "+gno") excludes every file when the folder is a gno
        // checkout itself. Deny-list only, so this holds in both a gno checkout
        // and a parent folder holding one. "**/x" does not match a root-level
        // "x", hence the bare entries alongside the nested ones.
        "build.directoryFilters": [
            "-**/node_modules",
            "-examples_ignored",
            "-gno/examples_ignored",
            "-.worktrees",
            "-.repos"
        ]
    },
    "js/ts.experimental.useTsgo": true,
    // Match shortcuts by the character a key types, not its physical position:
    // sway reports a US layout, so the default dispatch reads every key as qwerty.
    "keyboard.dispatch": "keyCode",
    "window.zoomLevel": 0.5
}