# Syncthing for ~/Offware/to-tablet alone. Off by default: it has no [Install]
# section, so only the waybar switch starts it.
[Unit]
Description=Syncthing for the Offware tablet folder
Documentation=man:syncthing(1)
StartLimitIntervalSec=60
StartLimitBurst=4

[Service]
ExecStart=/usr/bin/syncthing serve --home=%h/.local/state/syncthing-offware --no-browser --no-restart --no-upgrade
Restart=on-failure
RestartSec=1
SuccessExitStatus=3 4
RestartForceExitStatus=3 4
SystemCallArchitectures=native
MemoryDenyWriteExecute=true
NoNewPrivileges=true
